{
  "realm": "toolhive-demo",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "engineer",
        "description": "Builds and operates the platform"
      },
      {
        "name": "support",
        "description": "Works customer support tickets"
      }
    ]
  },
  "clients": [
    {
      "clientId": "toolhive-demo-cli",
      "name": "ToolHive demo token helper",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience: toolhive-demo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "toolhive-demo",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles -> roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "alice",
      "enabled": true,
      "email": "alice@acme.example",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Engineer",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "engineer"
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "support-bot",
      "enabled": true,
      "email": "support-bot@acme.example",
      "emailVerified": true,
      "firstName": "Support",
      "lastName": "Bot",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "support"
      ]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "bob",
      "enabled": true,
      "email": "bob@acme.example",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Intern",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ]
}